# Copy this file to .env.local and set the secrets (never commit .env.local).

###> Google Sign-In (Web application OAuth client) ###
# https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_SECRET=paste_web_client_secret_here
# Local only — must match how you open the site in the browser:
# DEFAULT_URI=http://127.0.0.1:8000

###> Paymongo ###
PAYMONGO_SECRET_KEY=sk_test_paste_your_secret_key_here
