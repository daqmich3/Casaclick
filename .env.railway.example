# Copy these into Railway → web service → Variables (RAW editor).
# Do NOT use 127.0.0.1 — link DATABASE_URL from the MySQL service.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me-to-a-long-random-string
JWT_PASSPHRASE=change-me-match-local-or-generate-new
DEFAULT_URI=https://your-app.up.railway.app

# Reference from MySQL service (recommended):
# DATABASE_URL=${{MySQL.MYSQL_URL}}
# Or paste MYSQL_URL value + append: ?serverVersion=8.0.32&charset=utf8mb4

GOOGLE_OAUTH_CLIENT_ID=264534690497-r526rlqoptnnbkmk19bnro0sdnkji1hv.apps.googleusercontent.com
GOOGLE_MOBILE_WEB_CLIENT_ID=264534690497-j0cl3eep1p4ensqk7es8moj6npsl92o7.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=

MAILER_DSN=null://null
MAILER_DEFAULT_EMAIL=CasaClick <your@email.com>

PAYMONGO_DEV_MOCK=1
PAYMONGO_SECRET_KEY=

CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1|10\.0\.2\.2|192\.168\.\d{1,3}\.\d{1,3}|your-app\.up\.railway\.app)(:[0-9]+)?$

TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
